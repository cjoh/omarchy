#!/bin/bash

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

# On the desktop you are working at, run in a VM instead; see test/live-desktop.
source "$ROOT/test/live-desktop"
if on_live_desktop; then
  run_in_vm_instead "$ROOT" ./test/all "$@"
fi
tests=(
  "$ROOT/test/cli"
  "$ROOT/test/shell"
)

# Run every suite even when an earlier one fails, so a single failure can't
# hide whole suites behind it.
failed=()
for test in "${tests[@]}"; do
  printf '==> %s\n' "${test#$ROOT/}"
  "$test" || failed+=("${test#$ROOT/}")
done

if (( ${#failed[@]} > 0 )); then
  printf '\n%d of %d suites failed:\n' "${#failed[@]}" "${#tests[@]}" >&2
  printf '  %s\n' "${failed[@]}" >&2
  exit 1
fi
